@namespace Reader.Shared.BaseUI

@inherits LayoutComponentBase
@implements IDisposable

@using Reader.Data.Storage
@using Reader.Shared.Layout
@using MudBlazor
@using Reader.Modules // Added for LoadingStateService
@inject LoadingStateService LoadingService

<MudThemeProvider IsDarkMode="@(true)" Theme="CustomDarkTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@Constants.ShareTitle</PageTitle>



<div class="app-content-wrapper @(isLoading ? "light-flow-active" : "")">
    <div class="light-flow-border light-flow-top"></div>
    <div class="light-flow-border light-flow-right"></div>
    <div class="light-flow-border light-flow-bottom"></div>
    <div class="light-flow-border light-flow-left"></div>
    <MudLayout>
        <Navbar />
        <MudMainContent Class="pa-0 ma-0"> 
            @Body
        </MudMainContent>
        <Footer />
        <SubFooter />
    </MudLayout>
</div>


@code {
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        base.OnInitialized(); 
        LoadingService.OnLoadingStateChanged += HandleLoadingStateChanged;
        isLoading = LoadingService.IsLoading; // Set initial state
    }

    private void HandleLoadingStateChanged()
    {
        isLoading = LoadingService.IsLoading;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LoadingService.OnLoadingStateChanged -= HandleLoadingStateChanged;
    }

    MudTheme CustomDarkTheme = new MudTheme()
        {
            Palette = new PaletteLight()
            {
                Primary = "#0b0a0c",
                Secondary = "#18191c",
                Tertiary = Colors.DeepPurple.Darken1
            },
            PaletteDark = new PaletteDark()
            {
                Primary = "#0b0a0c",
                Secondary = "#18191c",
                Tertiary = Colors.DeepPurple.Darken1
            },
            Typography = new Typography()
            {
                Default = new Default()
                {
                    FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" },
                    FontSize = "1rem",
                }
            }
        };
}
